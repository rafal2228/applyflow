# Copy to `.env.local` (gitignored). ApplyFlow is fully self-contained: it owns
# its database, discovery sources, digest and tailored applications.

# --- Local database + output paths (relative to this repo) ---
JOBS_DB_PATH=data/jobs.db
# CV_PATH=profile/CV.md
# BRIEF_PATH=profile/BRIEF.md

# --- Discovery credentials (optional) ---
# Adzuna is skipped unless these are set (free keys: https://developer.adzuna.com).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Market panel keywords (comma-separated; sensible defaults if unset) ---
# MONITOR_KEYWORDS=react,typescript,next.js,node,kubernetes,web3,solidity,engineering manager

# --- Daily digest minimum grade (A best … F worst) ---
# DIGEST_MIN_GRADE=B

# --- OpenAI-compatible LLM endpoint — enables auto-grading & tailoring ---
# Any server that speaks POST {base}/chat/completions. Either a base URL like
# `https://host/v1` (ApplyFlow appends `/chat/completions`) or the full URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model id sent to the endpoint (defaults to gpt-4o-mini if unset).
OPENAI_MODEL=gpt-4o-mini

# --- Duplicate review: local decision engine (Laya) ---
# Laya is a tiny on-prem decision model: https://huggingface.co/convaiinnovations/laya
# Start the sidecar with `npm run laya:serve`, then ApplyFlow asks it whether a
# candidate pair is the same role (no API cost, nothing leaves your machine).
# Falls back to OPENAI_* when LAYA_BASE_URL is unset.
# LAYA_BASE_URL=http://127.0.0.1:8000
# LAYA_API_KEY=
# Minimum fingerprint similarity (0-1) before a pair enters the review queue.
# DUPLICATE_THRESHOLD=0.5
# AI confidence (0-1) at/above which "Accept all" may auto-confirm duplicates.
# DUPLICATE_ACCEPT_CONFIDENCE=0.8
